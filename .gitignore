# ==========================================
# EMS (Event Management System) .gitignore
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (CRITICAL FOR GITHUB)
.env
.env.*
!.env.example
*.env
*.env.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
frontend/.env.local
!frontend/.env.example

# Production Build Outputs
backend/dist/
backend/script/
frontend/.next/
frontend/out/
frontend/script/
frontend/build/
dist/
build/

# Generated Prisma Client (regenerated during build)
backend/src/generated/prisma/

# Logs & Runtime Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE, Editor & Agent Configuration
.vscode/
.idea/
.agents/
.claude/
.windsurf/
.vercel
