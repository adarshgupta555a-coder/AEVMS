# ==============================================================================
# EMS Backend Environment Variables Configuration Template
# Duplicate this file to .env and supply actual credentials before starting.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Connections (Supabase / PostgreSQL)
# DATABASE_URL: Pooled connection string for production runtime execution
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct unpooled connection string used for Prisma migrations
DIRECT_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# JWT Security Secrets & Token Lifespans
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_characters_for_access_token
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_min_32_characters_for_refresh_token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin (Frontend Production URL)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# SMTP Email Configuration (Nodemailer TLS port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="EMS Team" <no-reply@yourdomain.com>

# Razorpay Online Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Initial Administrator Seed Credentials
INITIAL_ADMIN_EMAIL=admin@ems.local
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME="System Administrator"
