# ==============================================================================
# EMS Backend Environment Variables Configuration Template
# Duplicate this file to .env and supply actual credentials before starting.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Connections (PostgreSQL)
# DATABASE_URL: Pooled connection string for production runtime execution
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
# DIRECT_URL: Direct unpooled connection string used for Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT Security Secrets & Token Lifespans
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin (Frontend Production URL)
CORS_ORIGIN=https://your-frontend-domain.netlify.app

# SMTP Email Configuration (Nodemailer TLS port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="EMS Team" <no-reply@yourdomain.com>

# Razorpay Online Payment Gateway Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Initial Administrator Seed Credentials
INITIAL_ADMIN_EMAIL=admin@ems.local
INITIAL_ADMIN_PASSWORD=your_secure_admin_password
INITIAL_ADMIN_NAME="System Administrator"
